# Database Configuration
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=stockmate_ai

# Open-Weight AI Inference (Local or Cloud)
GEMMA_MODEL=gemma2:2b
OLLAMA_BASE_URL=http://localhost:11434

# Cloud Inference Providers (Optional for cloud deployments like Render)
# OpenRouter (Supports comma-separated keys for auto-rotation across free models)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Groq Cloud (Free high-speed open-weights inference)
GROQ_API_KEY=your_groq_api_key_here

# Google AI Studio / Gemini API (Free tier)
GEMINI_API_KEY=your_gemini_api_key_here
